# Code-Nest 容器运行示例环境变量

SPRING_PROFILES_ACTIVE=docker

XIAOU_MYSQL_URL=jdbc:mysql://mysql:3306/code_nest?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8
XIAOU_MYSQL_USERNAME=root
XIAOU_MYSQL_PASSWORD=123456

XIAOU_REDIS_ADDRESS=redis://redis:6379
XIAOU_REDIS_DATABASE=3
XIAOU_SA_TOKEN_REDIS_HOST=redis
XIAOU_SA_TOKEN_REDIS_PORT=6379
XIAOU_SA_TOKEN_REDIS_DATABASE=4

XIAOU_AI_PROVIDER=openai-compatible
XIAOU_AI_BASE_URL=https://your-openai-proxy.example.com/v1
XIAOU_AI_API_KEY=sk-xxxx
XIAOU_AI_CHAT_MODEL=gpt-5.4
XIAOU_AI_MAX_COMPLETION_TOKENS=2048
XIAOU_AI_RAG_ENABLED=true
XIAOU_AI_RAG_ENDPOINT=http://llamaindex-service:18080
XIAOU_AI_RAG_API_KEY=rag-local-key

# Enable only after all SRE tables, including investigation/evaluation tables, exist.
XIAOU_SRE_METRICS_ENABLED=false
XIAOU_SRE_METRICS_REFRESH_MS=10000
XIAOU_SRE_METRICS_INITIAL_DELAY_MS=15000

# Enable only after applying sre_rca_evaluation_queue.sql.
XIAOU_SRE_EVALUATION_ENABLED=false
XIAOU_SRE_EVALUATION_FIXED_DELAY_MS=2000
XIAOU_SRE_EVALUATION_INITIAL_DELAY_MS=10000
XIAOU_SRE_EVALUATION_BATCH_SIZE=2
XIAOU_SRE_EVALUATION_MAX_ATTEMPTS=3
XIAOU_SRE_EVALUATION_LEASE_SECONDS=180
XIAOU_SRE_EVALUATION_MAX_DURATION_SECONDS=1800
XIAOU_SRE_EVALUATION_MAX_CASES_PER_RUN=100
XIAOU_SRE_EVALUATION_RETRY_BACKOFF_SECONDS=10
XIAOU_SRE_EVALUATION_MAX_RETRY_BACKOFF_SECONDS=300
XIAOU_SRE_EVALUATION_SOURCE_REVISION=your_git_commit_sha
XIAOU_SRE_EVALUATION_BUILD_ID=your_ci_build_id
XIAOU_SRE_EVALUATION_BUILD_VERSION=2.5.0
